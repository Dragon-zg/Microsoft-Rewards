# Account Credentials
# Copy this file to .env and fill in your details.
# .env should be in your .gitignore, never commit your credentials!
#
# Add one numbered block per account starting at 1.
# The script stops looking at the first missing ACCOUNT_#_EMAIL

# Account 1
ACCOUNT_1_EMAIL=email@example.com
ACCOUNT_1_PASSWORD=your_password
#ACCOUNT_1_TOTP_SECRET=
#ACCOUNT_1_RECOVERY_EMAIL=
#ACCOUNT_1_GEO_LOCALE=cn
#ACCOUNT_1_LANG_CODE=zh
#ACCOUNT_1_PROXY_HTTP=false
#ACCOUNT_1_PROXY_URL=
#ACCOUNT_1_PROXY_PORT=0
#ACCOUNT_1_PROXY_USERNAME=
#ACCOUNT_1_PROXY_PASSWORD=
#ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=false
#ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=false

# Account 2 (duplicate block, increment for more accounts)
#ACCOUNT_2_EMAIL=email_2@example.com
#ACCOUNT_2_PASSWORD=your_password
#ACCOUNT_2_TOTP_SECRET=
#ACCOUNT_2_RECOVERY_EMAIL=
#ACCOUNT_2_GEO_LOCALE=cn
#ACCOUNT_2_LANG_CODE=zh
#ACCOUNT_2_PROXY_HTTP=false
#ACCOUNT_2_PROXY_URL=
#ACCOUNT_2_PROXY_PORT=0
#ACCOUNT_2_PROXY_USERNAME=
#ACCOUNT_2_PROXY_PASSWORD=
#ACCOUNT_2_SAVE_FINGERPRINT_MOBILE=false
#ACCOUNT_2_SAVE_FINGERPRINT_DESKTOP=false

# Optional proxy used only for Chrome/Edge version check requests
#CONFIG_PROXY_VERSION_CHECK_ENABLED=false
#CONFIG_PROXY_VERSION_CHECK_URL=http://user:pass@host:port

#CONFIG_WXPUSHER_ENABLED=true
#CONFIG_WXPUSHER_APPTOKEN=AT_xxx
#CONFIG_WXPUSHER_UIDS=UID_xxx,UID_yyy
#CONFIG_WXPUSHER_TOPIC_IDS=123,456
